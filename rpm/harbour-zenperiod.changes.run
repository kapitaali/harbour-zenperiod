#!/bin/bash
# RPM %changelog body, generated from git at build time.
# Takes precedence over harbour-zenperiod.changes. See: sfdk changelog --help

spec=rpm/harbour-zenperiod.spec
[ -f "$spec" ] || spec="$(dirname "$0")/harbour-zenperiod.spec"
version=$(sed -n 's/^Version:[[:space:]]*//p' "$spec")
release=$(sed -n 's/^Release:[[:space:]]*//p' "$spec")

author=$(git log -1 --pretty='format:%an <%ae>' 2>/dev/null)
[ -n "$author" ] || author="$(git config user.name) <$(git config user.email)>"
[ -n "$author" ] || author=$(sed -n '2s/^[^ ]* [^ ]* [0-9]* [0-9]* \([^ ]* [^ ]*\).*/\1/p' \
    "$(dirname "$0")/harbour-zenperiod.changes" 2>/dev/null)
[ -n "$author" ] || author="tester <tester@example.org>"

entries=$(sfdk-changelog --untagged-only 2>/dev/null)
if [ -n "$entries" ]; then
    echo "* $(date '+%a %b %-d %Y') $author - $version-$release"
    printf '%s\n' "$entries"
    echo
fi

sfdk-changelog || true
